# --- Core ---
DJANGO_SETTINGS_MODULE=novacrm.settings.dev
SECRET_KEY=change-me-to-a-50-char-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
SITE_URL=http://localhost:8000

# --- Database ---
DATABASE_URL=postgres://novacrm:novacrm@db:5432/novacrm

# --- Cache / queue / channels ---
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# --- Email (dev = console; prod = SMTP) ---
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=NovaCRM X <no-reply@novacrm.local>
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True

# --- Auth ---
JWT_ACCESS_LIFETIME_MIN=15
JWT_REFRESH_LIFETIME_DAYS=7

# --- AI ---
AI_PROVIDER=dummy             # dummy | openai | local
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
LOCAL_LLM_BASE_URL=http://localhost:11434/v1
LOCAL_LLM_MODEL=llama3

# --- Stripe (billing) ---
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLIC_KEY=

# --- Observability ---
SENTRY_DSN=
LOG_LEVEL=INFO

# --- Field-level encryption (Fernet, base64-encoded 32 bytes) ---
FIELD_ENCRYPTION_KEY=

# --- Tenancy ---
DEFAULT_TENANT_TRIAL_DAYS=14
TENANT_RESOLUTION=membership   # membership | subdomain
